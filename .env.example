# Copy to `.env` (auto-loaded by the model:* scripts, gitignored).
# Values here never override variables already set in your shell.

# Hugging Face read token — lets `pnpm model:outdated` check gated repos
# (Google, Nvidia, …) instead of showing them as "unknown".
# Also makes `model:redownload` / `model:outdated -i` fetch straight from Hugging Face
# (GGUF and MLX) instead of via `lms get`. Each run prints whether it was applied.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=
