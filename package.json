{
  "name": "lms-helper",
  "version": "1.0.0",
  "description": "Small pnpm helpers for managing LM Studio models from the CLI (delete / force re-download), pending `lms remove` upstream (lms#579).",
  "main": "index.js",
  "scripts": {
    "model:ls": "node scripts/list-models.mjs",
    "model:outdated": "node scripts/outdated-models.mjs",
    "model:rm": "node scripts/remove-model.mjs",
    "model:redownload": "node scripts/redownload-model.mjs"
  },
  "keywords": [
    "lmstudio",
    "lms",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.34.5 <11.0.0 || >=11.11.0 <12.0.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
